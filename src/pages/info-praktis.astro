---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Info Praktis Wisata ke Riung - Panduan Lengkap">
  <!-- Header -->
  <section class="bg-gradient-to-r from-gray-700 to-gray-900 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Info Praktis</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Panduan lengkap perjalanan ke Riung, dari akses hingga tips penting
      </p>
    </div>
  </section>

  <!-- Content -->
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Akses -->
    <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <span class="text-3xl">🚗</span> Cara Menuju Riung
      </h2>

      <div class="space-y-6">
        <div>
          <h3 class="text-xl font-semibold mb-2">Dari Bajawa</h3>
          <p class="text-gray-700 mb-3">
            Perjalanan darat 3-4 jam melewati jalan berkelok dengan pemandangan
            eksotis.
          </p>
          <div class="bg-blue-50 p-4 rounded-lg">
            <p class="font-semibold">Pilihan transportasi:</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Sewa mobil: Rp 500-700rb/hari</li>
              <li>Travel bersama: Rp 100-150rb/orang</li>
              <li>Ojek: Rp 200-250rb</li>
            </ul>
          </div>
        </div>

        <div>
          <h3 class="text-xl font-semibold mb-2">Dari Labuan Bajo</h3>
          <p class="text-gray-700">
            Bisa melalui jalur darat (12-14 jam) atau pesawat ke Bandara Bajawa
            Soa (terbang 45 menit).
          </p>
        </div>
      </div>
    </div>

    <!-- Transportasi Lokal -->
    <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <span class="text-3xl">🛵</span> Transportasi Lokal
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-lg font-semibold mb-2">Sewa Motor</h3>
          <p class="text-gray-700">
            Rp 70-100rb/hari (tersedia di homestay tertentu)
          </p>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-2">Sewa Boat 17 Pulau</h3>
          <p class="text-gray-700">Rp 600-800rb/boat (kapasitas 4-6 orang)</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-2">Ojek Lokal</h3>
          <p class="text-gray-700">Rp 20-30rb sekali jalan dalam desa</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold mb-2">Mobil Sewa + Driver</h3>
          <p class="text-gray-700">Rp 600-800rb/hari (termasuk BBM)</p>
        </div>
      </div>
    </div>

    <!-- Tips Penting -->
    <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <span class="text-3xl">💡</span> Tips Penting
      </h2>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <span class="text-2xl">💰</span>
          <div>
            <h3 class="font-semibold">Bawa Uang Tunai</h3>
            <p class="text-gray-600 text-sm">Belum banyak ATM di Riung</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="text-2xl">📱</span>
          <div>
            <h3 class="font-semibold">Sinyal Terbatas</h3>
            <p class="text-gray-600 text-sm">
              Di pulau, sinyal hilang. Nikmati offline!
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="text-2xl">☀️</span>
          <div>
            <h3 class="font-semibold">Waktu Terbaik</h3>
            <p class="text-gray-600 text-sm">April-Oktober (musim kemarau)</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="text-2xl">🩱</span>
          <div>
            <h3 class="font-semibold">Bawa Snorkel Sendiri</h3>
            <p class="text-gray-600 text-sm">
              Kalau punya, bawa sendiri lebih higienis
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="text-2xl">💊</span>
          <div>
            <h3 class="font-semibold">Obat Pribadi</h3>
            <p class="text-gray-600 text-sm">
              Apotek terbatas, bawa obat-obatan pribadi
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="text-2xl">📷</span>
          <div>
            <h3 class="font-semibold">Kamera</h3>
            <p class="text-gray-600 text-sm">
              Bawa kamera bawah laut/waterproof
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Kontak Darurat -->
    <div class="bg-red-50 rounded-xl p-8">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <span class="text-3xl">🆘</span> Kontak Penting
      </h2>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-white p-4 rounded-lg">
          <p class="font-semibold">Puskesmas Riung</p>
          <p class="text-gray-600">0384-123456</p>
        </div>
        <div class="bg-white p-4 rounded-lg">
          <p class="font-semibold">Polsek Riung</p>
          <p class="text-gray-600">0384-123457</p>
        </div>
        <div class="bg-white p-4 rounded-lg">
          <p class="font-semibold">Kantor Desa Riung</p>
          <p class="text-gray-600">0384-123458</p>
        </div>
        <div class="bg-white p-4 rounded-lg">
          <p class="font-semibold">Pemandu Wisata (Jack)</p>
          <p class="text-gray-600">0812-3456-7890</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
