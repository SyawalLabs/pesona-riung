---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomestayCard from "../../components/HomestayCard.astro";
import { homestayList } from "../../data/homestayData";
---

<BaseLayout title="Homestay di Riung - Tempat Menginap Nyaman">
  <!-- Header -->
  <section class="bg-gradient-to-r from-biru-laut to-blue-700 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Homestay di Riung</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Pilih tempat menginap nyaman untuk petualanganmu di 17 Pulau Riung
      </p>
    </div>
  </section>

  <!-- Daftar Homestay -->
  <section class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {homestayList.map((homestay) => <HomestayCard {...homestay} />)}
    </div>
  </section>
</BaseLayout>
