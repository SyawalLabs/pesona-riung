---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DestinasiCard from "../../components/DestinasiCard.astro";
import { destinasiList } from "../../data/destinasiData";
---

<BaseLayout title="Destinasi 17 Pulau Riung - Surga di Flores">
  <!-- Header -->
  <section class="bg-gradient-to-r from-green-600 to-blue-600 text-white py-16">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">17 Pulau Riung</h1>
      <p class="text-xl max-w-2xl mx-auto">
        Gugusan pulau eksotis dengan pasir putih, air jernih, dan keindahan
        bawah laut
      </p>
    </div>
  </section>

  <!-- Daftar Destinasi -->
  <section class="container mx-auto px-4 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {destinasiList.map((destinasi) => <DestinasiCard {...destinasi} />)}
    </div>
  </section>
</BaseLayout>
