---
export interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title,
  subtitle,
  image = "/images/hero-riung.jpg",
  ctaText,
  ctaLink,
} = Astro.props;
---

<div
  class="relative h-[80vh] min-h-[600px] flex items-center justify-center text-white"
>
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img src={image} alt={title} class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/40"></div>
    <!-- Overlay gelap -->
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <h1 class="text-5xl md:text-7xl font-bold mb-6 drop-shadow-lg">{title}</h1>
    {
      subtitle && (
        <p class="text-xl md:text-2xl mb-8 drop-shadow-md">{subtitle}</p>
      )
    }

    {
      ctaText && ctaLink && (
        <a
          href={ctaLink}
          class="inline-block bg-biru-laut hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-full text-lg transition transform hover:scale-105"
        >
          {ctaText}
        </a>
      )
    }
  </div>

  <!-- Scroll down indicator -->
  <div
    class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
  >
    <div
      class="w-6 h-10 border-2 border-white rounded-full flex justify-center"
    >
      <div class="w-1 h-3 bg-white rounded-full mt-2"></div>
    </div>
  </div>
</div>
