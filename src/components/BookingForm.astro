---
export interface Props {
  homestayName: string;
  homestayPhone: string;
}

const { homestayName, homestayPhone } = Astro.props;
---

<div class="bg-white rounded-xl shadow-lg p-6">
  <h3 class="text-xl font-semibold mb-4">Booking Langsung</h3>

  <form id="booking-form" class="space-y-4">
    <!-- Nama -->
    <div>
      <label class="block text-gray-700 mb-2">Nama Lengkap</label>
      <input
        type="text"
        id="name"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-biru-laut"
        required
      />
    </div>

    <!-- Tanggal -->
    <div>
      <label class="block text-gray-700 mb-2">Tanggal Check-in</label>
      <input
        type="date"
        id="date"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-biru-laut"
        required
      />
    </div>

    <!-- Jumlah Tamu -->
    <div>
      <label class="block text-gray-700 mb-2">Jumlah Tamu</label>
      <select
        id="guests"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-biru-laut"
      >
        <option value="1">1 orang</option>
        <option value="2">2 orang</option>
        <option value="3">3 orang</option>
        <option value="4">4 orang</option>
        <option value="5">5+ orang</option>
      </select>
    </div>

    <!-- Pesan Tambahan -->
    <div>
      <label class="block text-gray-700 mb-2">Pesan Tambahan</label>
      <textarea
        id="message"
        rows="3"
        class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-biru-laut"
        placeholder="Misal: request kamar dekat pantai..."></textarea>
    </div>

    <!-- Tombol Kirim -->
    <button
      type="submit"
      class="w-full bg-biru-laut hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition"
    >
      Kirim Pemesanan
    </button>
  </form>
</div>

<script>
  const form = document.getElementById("booking-form");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const name = document.getElementById("name").value;
      const date = document.getElementById("date").value;
      const guests = document.getElementById("guests").value;
      const message = document.getElementById("message").value;

      // Format pesan untuk WhatsApp
      const waMessage = `Halo, saya ingin booking ${homestayName}.\n\nNama: ${name}\nTanggal: ${date}\nJumlah Tamu: ${guests} orang\nPesan: ${message}`;

      // Redirect ke WhatsApp
      window.open(
        `https://wa.me/${homestayPhone}?text=${encodeURIComponent(waMessage)}`,
        "_blank",
      );
    });
  }
</script>
